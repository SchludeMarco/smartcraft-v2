# Lokales Setup: diese Datei nach .env kopieren und ausfüllen (siehe README.md
# Abschnitt "Deployment (Vercel)" für Quelle/Details je Variable).
# .env selbst ist per .gitignore ausgeschlossen und darf nie committet werden.

# --- Server-only (kein VITE_-Prefix, nie im Browser sichtbar) ---

# aistudio.google.com/apikey
GEMINI_API_KEY=

# Google Cloud Console -> APIs & Dienste -> Anmeldedaten
# (Cloud Text-to-Speech API muss aktiviert sein, Abrechnungskonto erforderlich)
GOOGLE_TTS_API_KEY=

# Firebase Console -> Projekteinstellungen -> Dienstkonten -> neuen privaten
# Schlüssel generieren (kompletter JSON-Inhalt als einzeiliger String).
# Optional: ohne diese Variable läuft api/gemini.js im dokumentierten
# Fail-open-Modus (App Check + Rate-Limiting deaktiviert). Wird auch von
# scripts/set-admin-claim.mjs benötigt.
FIREBASE_SERVICE_ACCOUNT_KEY=

# resend.com/api-keys
RESEND_API_KEY=

# Fällt auf VITE_ADMIN_EMAIL zurück, wenn leer
SUPPORT_EMAIL=

# Optional: eigene, bei resend.com/domains verifizierte Absenderdomain.
# Ohne diese Variable wird über Resends Sandbox-Absender verschickt, der nur
# an die beim Resend-Konto hinterlegte Signup-Adresse zustellen darf.
RESEND_FROM_EMAIL=

# --- Client (VITE_-Prefix, landet im Browser-Bundle) ---

# Firebase-Projekteinstellungen -> Meine Apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Optional: Firebase Console -> App Check -> Web-App registrieren
# (Site Key, nicht der Secret Key -- der geht nur in FIREBASE_SERVICE_ACCOUNT_KEY-seitiges App Check)
VITE_RECAPTCHA_SITE_KEY=

# Nur für den Mailto-Link im Admin-Bereich, kein Zugriffsschutz
VITE_ADMIN_EMAIL=
